<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment Update Confirmed</title>

    <style>
      body {
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        background-color: #f4f7f6;
        margin: 0;
        padding: 40px 0;
      }

      .container {
        max-width: 600px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 8px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        overflow: hidden;
      }

      .header {
        background: linear-gradient(135deg, #081630 0%, #1a365d 100%);
        padding: 30px 20px;
        text-align: center;
        color: #ffffff;
      }

      .header h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: 1px;
      }

      .content {
        padding: 40px 30px;
        color: #444444;
        font-size: 16px;
        line-height: 1.6;
      }

      .content p {
        margin-bottom: 20px;
      }

      .highlight-box {
        background-color: #e3f2fd;
        color: #1976d2;
        border-left: 4px solid #1976d2;
        padding: 15px 20px;
        margin: 25px 0;
        border-radius: 4px;
        font-weight: bold;
        font-size: 18px;
        text-align: center;
        letter-spacing: 0.5px;
      }

      .receipt-table {
        width: 100%;
        margin-top: 30px;
        border-collapse: collapse;
      }

      .receipt-table th {
        text-align: left;
        padding: 12px 0;
        border-bottom: 2px solid #eeeeee;
        color: #888888;
        font-weight: 600;
        font-size: 14px;
        text-transform: uppercase;
      }

      .receipt-table td {
        padding: 15px 0;
        border-bottom: 1px solid #eeeeee;
        font-size: 16px;
        color: #333333;
      }

      .receipt-table tr:last-child td {
        border-bottom: none;
      }

      .receipt-table .label {
        color: #666666;
      }

      .receipt-table .value {
        font-weight: bold;
        text-align: right;
      }

      .btn {
        display: block;
        width: 220px;
        margin: 40px auto 10px;
        padding: 14px 20px;
        background-color: #ff8c00;
        color: #ffffff;
        text-align: center;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        font-size: 16px;
        transition: background-color 0.3s;
      }

      .btn:hover {
        background-color: #e67e00;
      }

      .footer {
        background-color: #f9f9f9;
        padding: 20px;
        text-align: center;
        font-size: 13px;
        color: #777777;
        border-top: 1px solid #eeeeee;
      }

      .footer a {
        color: #081630;
        text-decoration: none;
      }
    </style>
  </head>

  <body>
    <div class="container">
      <!-- Header -->
      <div class="header">
        <h1>Payment Updated</h1>
      </div>

      <!-- Content -->
      <div class="content">
        <p>Hello <strong><%= locals.firstName || 'Learner' %></strong>,</p>

        <p>
          Your payment have been successfully updated for your course
          registration. Thank you for keeping your account up to date!
        </p>

        <!-- Highlight Box for Status -->
        <div class="highlight-box">UPDATE SUCCESSFUL</div>

        <!-- Payment Details -->
        <table class="receipt-table">
          <tr>
            <th colspan="2">Transaction Details</th>
          </tr>
          <tr>
            <td class="label">Course Name</td>
            <td class="value">
              <%= locals.courseName || 'Learn Code Premium Course' %>
            </td>
          </tr>
          <tr>
            <td class="label">Transaction ID</td>
            <td class="value"><%= locals.paymentId || 'N/A' %></td>
          </tr>
          <tr>
            <td class="label">Amount</td>
            <td class="value">&#8358;<%= locals.amount || 'N/A' %></td>
          </tr>
          <tr>
            <td class="label">Date</td>
            <td class="value"><%= new Date().toLocaleDateString() %></td>
          </tr>
        </table>

        <a href="https://learncode.com/dashboard" class="btn"
          >View My Courses</a
        >

        <p style="margin-top: 35px; font-size: 14px">
          If you have any questions, feel free to contact our support team at
          <a href="mailto:admin.learncode@gmail.com"
            >admin.learncode@gmail.com</a
          >.
        </p>
      </div>

      <!-- Footer -->
      <div class="footer">
        <p>
          &copy; <%= new Date().getFullYear() %> Learn Code. All rights
          reserved.
        </p>
      </div>
    </div>
  </body>
</html>
